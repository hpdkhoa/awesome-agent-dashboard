{
  // Cloudflare Workers: the built files in ./dist, plus worker/index.ts for /api/* (the Vietcombank rate route).
  // (the build runs `npm run build`, then `npx wrangler deploy`, which reads this)
  "name": "awesome-agent-dashboard",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
