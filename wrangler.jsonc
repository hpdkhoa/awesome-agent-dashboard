{
  // Cloudflare Workers, static assets only: no Worker script; Cloudflare serves the built files in ./dist
  // (the build runs `npm run build`, then `npx wrangler deploy`, which reads this)
  "name": "awesome-agent-dashboard",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
