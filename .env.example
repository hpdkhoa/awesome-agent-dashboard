# Copy to .env and fill in. .env is never committed.

# The one Google account allowed in. Used only to build firestore.rules on your machine.
# It is never sent to the web build.
OWNER_EMAIL=

# Your own Firebase project (public by design; the Firestore rules are the lock).
# Set the same VITE_ values in the Cloudflare Pages project settings.
FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# The bridge (bridge/), on each machine that runs Claude Code. Optional.
# Work types: name=folder pairs, separated by ;  A session belongs to the type whose folder holds its working folder.
WORK_ROOTS=
# Claude Code's log folder, if not the default ~/.claude/projects
CLAUDE_LOGS=
# This machine's name on the dashboard, if not the host name
MACHINE_NAME=
# The claude CLI used to resume closed sessions with your answers, if not on PATH
CLAUDE_BIN=
# The file viewer (bridge/agent_bridge/files.py): the page shows files from this machine through your own
# Cloudflare Tunnel, never stored. FILES_URL is the tunnel's public address, routed to http://localhost:FILES_PORT.
# SITE_ORIGINS: the page origins allowed to ask it, separated by ;  Leave FILES_URL empty to keep it off.
FILES_URL=
FILES_PORT=8793
SITE_ORIGINS=
