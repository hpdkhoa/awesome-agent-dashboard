# Environment: only .env.example is tracked
.env
.env.*
!.env.example

# Tokens and credentials, never tracked
*token*
*credential*
*.key
*.pem
service-account*.json

# Built from firestore.rules.template at deploy time (holds the owner's email)
firestore.rules

